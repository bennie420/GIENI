{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@gieni/database": ["../../packages/database/src"],
      "@gieni/database/*": ["../../packages/database/src/*"],
      "@gieni/authz": ["../../packages/authz/src"],
      "@gieni/authz/*": ["../../packages/authz/src/*"],
      "@gieni/evidence": ["../../packages/evidence/src"],
      "@gieni/evidence/*": ["../../packages/evidence/src/*"],
      "@gieni/property": ["../../packages/property/src"],
      "@gieni/property/*": ["../../packages/property/src/*"],
      "@gieni/ownership": ["../../packages/ownership/src"],
      "@gieni/ownership/*": ["../../packages/ownership/src/*"],
      "@gieni/authority": ["../../packages/authority/src"],
      "@gieni/authority/*": ["../../packages/authority/src/*"],
      "@gieni/scoring": ["../../packages/scoring/src"],
      "@gieni/scoring/*": ["../../packages/scoring/src/*"],
      "@gieni/workflow": ["../../packages/workflow/src"],
      "@gieni/workflow/*": ["../../packages/workflow/src/*"],
      "@gieni/qc": ["../../packages/qc/src"],
      "@gieni/qc/*": ["../../packages/qc/src/*"],
      "@gieni/delivery": ["../../packages/delivery/src"],
      "@gieni/delivery/*": ["../../packages/delivery/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
